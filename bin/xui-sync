#!/usr/bin/env bash
# ==============================================================================
# xui-sync: Lightweight CLI Controller for 3X-UI, Nginx Gateway & Shop Bot
# ==============================================================================

SYNC_SCRIPT="/usr/local/bin/xui-nginx-sync.py"
DB_PATH="/etc/x-ui/x-ui.db"

show_help() {
    echo "=========================================================="
    echo "                  xui-sync Control Utility                "
    echo "=========================================================="
    echo "Usage: xui-sync [command]"
    echo ""
    echo "Commands:"
    echo "  (no args)    Run database & Nginx synchronization engine"
    echo "  status       Check status of Nginx, 3X-UI, Bot and open ports"
    echo "  hosts        View active Hosts table from 3X-UI database"
    echo "  reload       Force synchronization and reload Nginx"
    echo "  log          View live logs of the auto-sync background watcher"
    echo "  help         Display this help message"
    echo "=========================================================="
}

cmd_sync() {
    if [[ ! -f "$SYNC_SCRIPT" ]]; then
        echo "Error: $SYNC_SCRIPT not found. Please run install.sh first."
        exit 1
    fi
    python3 "$SYNC_SCRIPT"
}

cmd_status() {
    echo "--- Service Status ---"
    systemctl status nginx --no-pager -l | head -n 5 || true
    echo ""
    systemctl status x-ui --no-pager -l | head -n 5 || true
    echo ""
    systemctl status xui-nginx-sync.path --no-pager -l | head -n 5 || true
    echo ""
    if systemctl is-active --quiet xui-bot.service; then
        systemctl status xui-bot.service --no-pager -l | head -n 5 || true
    fi
    echo ""
    echo "--- Active Listening Ports ---"
    ss -tulpn | grep -E 'x-ui|nginx|python3' || true
}

cmd_hosts() {
    if [[ ! -f "$DB_PATH" ]]; then
        echo "Error: Database $DB_PATH not found."
        exit 1
    fi
    echo "=== 3X-UI Hosts Table ==="
    sqlite3 "$DB_PATH" -header -column "SELECT id, inbound_id, remark, address, port, security, sni, host_header, path, ech_config_list FROM hosts;" 2>/dev/null || echo "Hosts table is empty or not yet migrated."
}

cmd_log() {
    journalctl -u xui-nginx-sync.service -n 30 --no-pager -f
}

case "$1" in
    ""|"run")
        cmd_sync
        ;;
    "status")
        cmd_status
        ;;
    "hosts")
        cmd_hosts
        ;;
    "reload")
        cmd_sync
        systemctl reload nginx
        ;;
    "log"|"logs")
        cmd_log
        ;;
    "help"|"-h"|"--help")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
